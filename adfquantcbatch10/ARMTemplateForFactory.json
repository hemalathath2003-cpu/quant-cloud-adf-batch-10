								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "DS_DYNAMIC_BLOB_INPUT",
								"type": "DatasetReference",
								"parameters": {
									"FolderName": "input",
									"FileName": {
										"value": "@pipeline().parameters.SourceFileName",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_DYNAMIC_BLOB_OUTPUT",
								"type": "DatasetReference",
								"parameters": {
									"FolderName": "output",
									"FileName": {
										"value": "@concat(\n        pipeline().parameters.SourceFileName,\n        '_',\n        pipeline().parameters.TargetFileName,\n        '_',\n        formatDateTime(startOfDay(utcNow()))\n        )",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"SourceFileName": {
						"type": "string"
					},
					"TargetFileName": {
						"type": "string"
					}
